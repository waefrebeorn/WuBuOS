    (void)s;
    fprintf(stderr, "wcc_quartz: NOT IMPLEMENTED (stub) — see "
                    "buy-wubu-a-mac/research/05-wayland-on-macos.md\n");
    return -1;
}

void wcc_quartz_present(struct wcc_server *s, const void *data,
                        int w, int h, int stride) {
    (void)s; (void)data; (void)w; (void)h; (void)stride;
    /* deliberate no-op: a stub must not draw garbage */
}

void wcc_quartz_destroy(struct wcc_server *s) {
    (void)s;
}