+/* Narrow instruction-fetch permission hook, consulted by the decoder before
+ * fetching the byte at RIP. Fetch is governed by EXECUTE permission only;
+ * NULL (the default) keeps legacy guest RAM executable. */
+typedef int (*WemuFetchPermFn)(uint64_t va, size_t len, void *ud);
+void wemu_set_fetch_perm_hook(WemuFetchPermFn fn, void *ud);
 
