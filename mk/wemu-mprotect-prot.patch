+/* Decoder-side access to the fetch hook: returns nonzero when the optional
+ * EXEC hook denies `va`. Hook state stays owned in this file. */
+int wemu_check_fetch_perm(uint64_t va, size_t len) {
+    return g_fetch_perm_fn && g_fetch_perm_fn(va, len, g_fetch_perm_ud);
