# Narrow overlay: VSL mprotect/fetch permission hooks. Generated from the pinned
# combined WEMU sources (fork/clone + sandbox); apply with patch -p1 -d build/wemu-user.
diff -ruN clean2/include/wemu.h patched/include/wemu.h
--- a/include/wemu.h	2026-11-20 21:21:16.000000000 -0500
+++ b/include/wemu.h	2026-11-20 21:22:46.792596311 -0500
@@ -39,6 +39,19 @@
 int wemu_mem_read(WemuCpu *cpu, uint64_t va, void *dst, size_t len);
 int wemu_mem_write(WemuCpu *cpu, uint64_t va, const void *src, size_t len);
 
+/* Optional guest-memory permission hook (WuBuOS VSL mprotect enforcement).
+ * Return 0 to allow the access; nonzero denies it and WEMU raises #PF with
+ * CR2 = va. A NULL hook (the default) keeps legacy guest RAM permissive.
+ * is_write distinguishes loads (0) from stores (1); PROT_NONE denies both. */
+typedef int (*WemuMemPermFn)(uint64_t va, size_t len, int is_write, void *ud);
+void wemu_set_mem_perm_hook(WemuMemPermFn fn, void *ud);
+
+/* Narrow instruction-fetch permission hook, consulted by wemu_mem_fetch.
+ * Fetch is governed by EXECUTE permission only; NULL keeps legacy RAM
+ * executable. */
+typedef int (*WemuFetchPermFn)(uint64_t va, size_t len, void *ud);
+void wemu_set_fetch_perm_hook(WemuFetchPermFn fn, void *ud);
+
 /* Paging control: cr3 + CR0.PG. Without it, VA == GPA. */
 void wemu_cpu_set_cr3(WemuCpu *cpu, uint64_t cr3);
 void wemu_cpu_enable_paging(WemuCpu *cpu, int on);
diff -ruN clean2/src/wemu_internal.h patched/src/wemu_internal.h
--- a/src/wemu_internal.h	2026-11-20 21:21:16.000000000 -0500
+++ b/src/wemu_internal.h	2026-11-20 21:22:46.793609597 -0500
@@ -135,6 +135,11 @@
                            int is_user, int is_fetch, int *fault);
 uint64_t wemu_translate(WemuCpu *cpu, uint64_t va, int is_write, int is_user,
                         int *fault);
+/* translated read WITHOUT the data-read permission hook: instruction fetch
+ * uses wemu_mem_fetch and is gated by the separate EXEC hook. */
+int wemu_mem_read_no_perm(WemuCpu *cpu, uint64_t va, void *dst, size_t len);
+/* decoder/memory owner access to the fetch hook; hook state stays in mem.c. */
+int wemu_check_fetch_perm(uint64_t va, size_t len);
 /* Instruction-fetch read (wemu_decode.c): same walk with is_fetch=1. */
 int wemu_mem_fetch(WemuCpu *cpu, uint64_t va, void *dst, size_t len);
 
diff -ruN clean2/src/wemu_mem.c patched/src/wemu_mem.c
--- a/src/wemu_mem.c	2026-11-20 21:21:16.000000000 -0500
+++ b/src/wemu_mem.c	2026-11-20 21:22:46.793720297 -0500
@@ -3,6 +3,24 @@
 #include "wemu_internal.h"
 #include <stdlib.h>
 
+/* Optional permission hooks. Single owners; NULL means permissive legacy
+ * guest RAM. Installed by the WuBuOS WEMU bridge. */
+static WemuMemPermFn g_mem_perm_fn;
+static void *g_mem_perm_ud;
+void wemu_set_mem_perm_hook(WemuMemPermFn fn, void *ud) {
+    g_mem_perm_fn = fn;
+    g_mem_perm_ud = ud;
+}
+static WemuFetchPermFn g_fetch_perm_fn;
+static void *g_fetch_perm_ud;
+void wemu_set_fetch_perm_hook(WemuFetchPermFn fn, void *ud) {
+    g_fetch_perm_fn = fn;
+    g_fetch_perm_ud = ud;
+}
+int wemu_check_fetch_perm(uint64_t va, size_t len) {
+    return g_fetch_perm_fn && g_fetch_perm_fn(va, len, g_fetch_perm_ud);
+}
+
 int wemu_gpa_read(WemuCpu *cpu, uint64_t gpa, void *dst, size_t len) {
     if (gpa > cpu->ram_size || len > cpu->ram_size - gpa) {
         cpu->fault = 13; /* #GP: outside guest RAM */
@@ -133,6 +151,12 @@
         if (f) { cpu->fault = f; return -1; }
         uint64_t chunk = 0x1000 - (va & 0xfff);
         if (chunk > len) chunk = len;
+        if (g_mem_perm_fn &&
+            g_mem_perm_fn(va, (size_t)chunk, 0, g_mem_perm_ud)) {
+            cpu->fault = 14;               /* #PF: load from a protected page */
+            cpu->cr2 = va;
+            return -1;
+        }
         if (wemu_gpa_read(cpu, gpa, d, (size_t)chunk) != 0) return -1;
         va += chunk; d += chunk; len -= (size_t)chunk;
     }
@@ -148,6 +172,13 @@
         if (f) { cpu->fault = f; return -1; }
         uint64_t chunk = 0x1000 - (va & 0xfff);
         if (chunk > len) chunk = len;
+        if (g_fetch_perm_fn &&
+            g_fetch_perm_fn(va, (size_t)chunk, g_fetch_perm_ud)) {
+            cpu->fault = 14;                  /* #PF: fetch from a no-EXEC page */
+            cpu->fault_error = 0x10;          /* I/D = 1 for instruction fetch */
+            cpu->cr2 = va;
+            return -1;
+        }
         if (wemu_gpa_read(cpu, gpa, d, (size_t)chunk) != 0) return -1;
         va += chunk; d += chunk; len -= (size_t)chunk;
     }
@@ -162,6 +193,12 @@
         if (f) { cpu->fault = f; return -1; }
         uint64_t chunk = 0x1000 - (va & 0xfff);
         if (chunk > len) chunk = len;
+        if (g_mem_perm_fn &&
+            g_mem_perm_fn(va, (size_t)chunk, 1, g_mem_perm_ud)) {
+            cpu->fault = 14;               /* #PF: store to a protected page */
+            cpu->cr2 = va;
+            return -1;
+        }
         if (wemu_gpa_write(cpu, gpa, s, (size_t)chunk) != 0) return -1;
         va += chunk; s += chunk; len -= (size_t)chunk;
     }
