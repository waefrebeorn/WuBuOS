		$(RT)/wubu_ns_background.c $(RT)/wubu_session_boot.c $(RT)/wubu_xdg_autostart.c $(RT)/wubu_bus.c $(RT)/wubu_logind.c $(RT)/wubu_auth.c \
		$(RT)/wubu_effect.c $(RT)/wubu_ns_effect.c \
		/tmp/wubu_ns_background_test.o \
		-o $(RT)/wubu_ns_background_test
	$(RT)/./wubu_ns_background_test

# test_svc_socket -- P3 socket-activation contract (Mint baseline §4.2): a
# named Unix-domain listening socket fires its activator ONCE on the first
# connection (on-demand service start), and afterwards hands the accepted fd
# to the service (systemd LISTEN_FDS delivery). Test uses a real client to
# prove the activation primes, the refused path re-primes, and the accepted fd
# is genuinely usable (byte write/read round-trip).
test_svc_socket: $(RT)/wubu_svc_socket.c $(RT)/wubu_svc_socket.h $(RT)/wubu_svc_socket_test.c
	$(CC) -O0 -g -std=c11 -Wall -I$(RT) $(RT)/wubu_svc_socket_test.c $(RT)/wubu_svc_socket.c -o $(RT)/wubu_svc_socket_test
	$(RT)/./wubu_svc_socket_test

# test_login -- P3 logind-equivalent (Mint baseline §4.3 / §153): a session
# registry (id/seat/type/class/uid/state) where the login manager logs the
# active session, plus machine power ops (suspend/reboot/shutdown) gated by an
# injectable authorizer (the polkit seam). Test proves: register/replace/query
# by id and active state, authorized op allowed, denied op refused, and power
# refused when no authorizer or no active session.
test_logind: $(RT)/wubu_logind.c $(RT)/wubu_logind.h $(RT)/wubu_logind_test.c
	$(CC) -O0 -g -std=c11 -Wall -I$(RT) $(RT)/wubu_logind_test.c $(RT)/wubu_logind.c -o $(RT)/wubu_logind_test
	$(RT)/./wubu_logind_test

# test_auth -- P3 polkit-equivalent authority (Mint baseline §4.4 / §154):
# SUBJECT -> ACTION -> allow/deny/interactive decision model. A hard DENY
# overrules; a wildcard subject matches any uid; an INTERACT rule resolves via
# the per-session agent (fail-closed with no agent); unknown actions default
# to DENY. Test proves the decision matrix including the deny-overrule,
# wildcard, interactive-approve / interactive-deny, and no-agent-fail-closed
# paths.
test_auth: $(RT)/wubu_auth.c $(RT)/wubu_auth.h $(RT)/wubu_auth_test.c
	$(CC) -O0 -g -std=c11 -Wall -I$(RT) $(RT)/wubu_auth_test.c $(RT)/wubu_auth.c -o $(RT)/wubu_auth_test
	$(RT)/./wubu_auth_test

# test_session_daemon -- P3 role-up: the desktop-owned session-manager daemon
# that composes the five contracts (session-boot bus+autostart, logind login,
# polkit auth WIRED as the login power gate) and publishes /n/background
# (bus + session/ + auth/). Test runs the whole lifecycle: register active
# session, install an auth grant, start autostart apps via a fake launcher,
# publish the /n/background state, and sink power through the wired authority.
