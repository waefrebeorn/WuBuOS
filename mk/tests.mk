	$(CC) -O0 -g -std=c11 -D_POSIX_C_SOURCE=200809L -DVBE_HOSTED \
		-I$(APPS) -I$(GUI) -I$(RT) -I$(KERNEL) -I$(RT) \
		$(APPS)/apps_weak_test.c $(APPS)/apps.c $(APPS)/apps_wet.c \
		-o $(APPS)/apps_weak_test
	$(APPS)/apps_weak_test

