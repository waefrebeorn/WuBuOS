# DA-3: verifier + self-improvement loop integration test
test_bytropix_verifier:
	$(CC) $(CFLAGS) -Iinclude -I$(RT) -o $(RT)/test_bytropix_verifier \
		tools/test_bytropix_verifier.c \
		$(RT)/wubu_selfimprove.c \
