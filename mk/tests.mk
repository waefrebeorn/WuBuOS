	$(CC) -O0 -g -DWUBU_HOSTED -D_GNU_SOURCE -I$(COMP) -I$(JIT) -I$(KERNEL) -I$(RT) $(JIT_SRCS) $(RT)/wubu_spawn.c $(COMP)/holyd_lexer.c $(COMP)/holyd_parse.c $(COMP)/holyd_parse_ast.c $(COMP)/holyd_codegen.c $(COMP)/holyd_codegen_emit.c $(COMP)/holyd_codegen_expr.c $(COMP)/holyd_codegen_stmt.c $(COMP)/holyd_codegen_api.c $(COMP)/wubu_preproc.c $(COMP)/holyd_runtime.c $(COMP)/holyd_pe.c $(RT)/test/wubu_selfbuild_test.c $(RT)/wubu_applaunch.c $(RT)/wubu_session_boot.c $(RT)/wubu_xdg_autostart.c $(RT)/wubu_bus.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_zxreg.c $(KERNEL)/wubu_sha256.c $(KERNEL)/wubu_modsym.c $(RT)/wubu_zxload.c $(RT)/wubu_ns_fs.c -o $(KERNEL)/wubu_selfbuild_test -ldl
	$(KERNEL)/./wubu_selfbuild_test

# test-module -- THE one-command green gate for the whole module/PE/self-build
# stack. The aggregate that runs inside wubuwos CI: PE loader contract + holyd
# emitter + /n module registry + session->/n app-launch + self-build. Every
# member must pass or the gate is RED. Use this INSTEAD of hand-looping the
# eight targets (that hand-loop is exactly the workflow pathology that let a
# broken push slip through — one command, one verdict).
.PHONY: test-module
test-module: test_holyd_pe test_pe_globals test_pe_program test_pe_import \
             test_pe_reloc test_pe_exec test_pe_iat test_pe_full \
             test_wubu_zx test_wubu_zxload test_wubu_zxreg test_wubu_applaunch \
             test_wubu_selfbuild test_wubu_zx9p test_w9pc test_wubu_tokenizer \
             test_ns_9p test_styxfs test_owned_surface test_wubu_onboarding
	@echo "== [test-module] all module/PE/self-build/9P/owned-surface/onboarding targets GREEN =="

# GAP-C2 enforcement: a module without a test recipe is NOT owned. Re-derives
# the manifest from the Makefile recipes and FAILS if an OWNED module lost its
# recipe or the committed manifest went stale.
.PHONY: test_owned_surface
test_owned_surface:
	python3 scripts/owned_surface.py --check

# test-cover -- operationalize the OWNED/UNOWNED classification (GAP C1) as a
# command: a first-pass sieve of which src/kernel + src/runtime .c files are
# textually referenced by a makefile. Use this to audit the junk-drawer/untested
# surface; read the caveat in the script (wildcard-built files like the
# bare-metal kernel land here too -- verify with `make -n` before acting).
.PHONY: test-cover
test-cover:
	python3 scripts/unowned_surface.py

# test_wubu_zx9p -- the loader consumes a module over REAL Styx/9P (the kernel-leg
# TRANSPORT of the /n read). A module PE is published under a host dir mounted as
# 9P "/"; a 9P client WALK+OPEN+READs it, and wubu_zx_run runs the fetched bytes
# (import resolves via registry -> 7, at two bases). No stdio/compiler link.
test_wubu_zx9p: $(KERNEL)/test/wubu_zx9p_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_modsym.c $(RT)/styx_names.c $(RT)/styx_enc.c $(RT)/styx_serve.c $(RT)/styx_parse.c $(RT)/styx_fid.c $(RT)/styxfs_vfs.c $(RT)/styxfs_callbacks.c $(RT)/styxfs_posix.c $(RT)/styxfs_path.c $(RT)/styxfs_host.o $(RT)/styxfs_util.c
	$(CC) -O0 -g -std=c11 -D_POSIX_C_SOURCE=200809L -include wubu_gnu_compat.h -Wno-format-truncation -I$(RT) -I$(KERNEL) $(KERNEL)/test/wubu_zx9p_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_modsym.c $(RT)/styx_names.c $(RT)/styx_enc.c $(RT)/styx_serve.c $(RT)/styx_parse.c $(RT)/styx_fid.c $(RT)/styxfs_vfs.c $(RT)/styxfs_callbacks.c $(RT)/styxfs_posix.c $(RT)/styxfs_path.c $(RT)/styxfs_host.o $(RT)/styxfs_util.c $(RT)/wubu_container.c $(RT)/wubu_spawn.c -o $(KERNEL)/wubu_zx9p_test
	$(KERNEL)/./wubu_zx9p_test

# test_w9pc -- the KERNEL-CLEAN 9P client (wubu_9pc) drives a real Styx/9P server
# and feeds the loader (GAP A2 proof). TWO gates in one target:
#   (1) wubu_9pc.c compiles under the FREESTANDING kernel flags (no libc
#       guarantee) -- the on-kernel compile proof;
#   (2) the hosted link then uses that same client to fetch a module over real
#       9P and run it (the server rejecting a malformed frame is the proof the
#       codec is correct).
test_w9pc: $(KERNEL)/wubu_9pc.c $(KERNEL)/wubu_9pc.h $(KERNEL)/test/w9pc_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_modsym.c $(RT)/styx_names.c $(RT)/styx_enc.c $(RT)/styx_serve.c $(RT)/styx_parse.c $(RT)/styx_fid.c $(RT)/styxfs_vfs.c $(RT)/styxfs_callbacks.c $(RT)/styxfs_posix.c $(RT)/styxfs_path.c $(RT)/styxfs_host.o $(RT)/styxfs_util.c
	$(CC) -ffreestanding -nostdlib -fno-pie -fno-pic -mcmodel=kernel -std=c11 -I$(KERNEL) -c $(KERNEL)/wubu_9pc.c -o /tmp/w9pc_kernel.o && echo "[w9pc] kernel-clean compile PASS"
	$(CC) -O0 -g -std=c11 -D_POSIX_C_SOURCE=200809L -include wubu_gnu_compat.h -Wno-format-truncation -I$(RT) -I$(KERNEL) $(KERNEL)/test/w9pc_test.c $(KERNEL)/wubu_9pc.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_modsym.c $(RT)/styx_names.c $(RT)/styx_enc.c $(RT)/styx_serve.c $(RT)/styx_parse.c $(RT)/styx_fid.c $(RT)/styxfs_vfs.c $(RT)/styxfs_callbacks.c $(RT)/styxfs_posix.c $(RT)/styxfs_path.c $(RT)/styxfs_host.o $(RT)/styxfs_util.c $(RT)/wubu_container.c $(RT)/wubu_spawn.c -o $(KERNEL)/w9pc_test
	$(KERNEL)/./w9pc_test

# test_wubu_tokenizer -- GAP B3: a self-hosted compiler STAGE runs through the
# loader. The compiler reads its own tokenizer.hd (holyd-language), emits a PE,
# and wubu_zx_run runs it -> 4 tokens in "int x = 42". This is the
# holyd-compiles-holyd seed (a lexer executing as a holyd program, not a host
# harness). Link: compiler + loader only (no session/applaunch/zxreg).
test_wubu_tokenizer: $(RT)/selfbuild/tokenizer.hd $(RT)/selfbuild/expr.hd $(RT)/selfbuild/param.hd $(RT)/selfbuild/num.hd $(RT)/selfbuild/checksum.hd $(RT)/selfbuild/struct.hd $(KERNEL)/test/tokenizer_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_modsym.c $(COMP)/holyd_codegen.h $(COMP)/holyd_pe.c
	$(CC) -O0 -g -DWUBU_HOSTED -D_GNU_SOURCE -I$(COMP) -I$(JIT) -I$(KERNEL) -I$(RT) $(JIT_SRCS) $(RT)/wubu_spawn.c $(COMP)/holyd_lexer.c $(COMP)/holyd_parse.c $(COMP)/holyd_parse_ast.c $(COMP)/holyd_codegen.c $(COMP)/holyd_codegen_emit.c $(COMP)/holyd_codegen_expr.c $(COMP)/holyd_codegen_stmt.c $(COMP)/holyd_codegen_api.c $(COMP)/wubu_preproc.c $(COMP)/holyd_runtime.c $(COMP)/holyd_pe.c $(KERNEL)/test/tokenizer_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_modsym.c -o $(KERNEL)/tokenizer_test -ldl
	$(KERNEL)/./tokenizer_test


# test_pe_import -- rung 6: holyd EMITS an import-carrying PE. The emitter
# (hd_write_pe_imported) lays out .idata (descriptor+ILT+INT+IAT+name rows+dll)
# and rewrites a call qword[rip+disp] to reach its IAT slot; wubu_zx_run snaps
# that IAT via the registry and runs the entry, which calls through it -> the
# registered host function's result. Prove a compiler-produced PE carries and
# resolves its own imports.
test_pe_import: $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_pe.h $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_zx.h $(KERNEL)/wubu_modsym.c $(KERNEL)/wubu_modsym.h $(KERNEL)/test/wubu_pe_import_test.c $(COMP)/holyd_codegen.h $(COMP)/holyd_pe.c
	$(CC) -O0 -g -DWUBU_HOSTED -I$(COMP) -I$(JIT) -I$(KERNEL) $(JIT_SRCS) $(RT)/wubu_spawn.c $(COMP)/holyd_lexer.c $(COMP)/holyd_parse.c $(COMP)/holyd_parse_ast.c $(COMP)/holyd_codegen.c $(COMP)/holyd_codegen_emit.c $(COMP)/holyd_codegen_expr.c $(COMP)/holyd_codegen_stmt.c $(COMP)/holyd_codegen_api.c $(COMP)/wubu_preproc.c $(COMP)/holyd_runtime.c $(COMP)/holyd_pe.c $(KERNEL)/test/wubu_pe_import_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_zx.c $(KERNEL)/wubu_modsym.c -o $(KERNEL)/wubu_pe_import_test -ldl
	$(KERNEL)/./wubu_pe_import_test

# test_pe_modsym -- P2 Piece A: loader import resolution goes through the
# runtime-extensible symbol registry (wubu_modsym), not a hardcoded callback.
# A PE importing NTOSKRNL.EXE!ANSWER is loaded; wubu_pe_snap_iat resolves via
# wubu_modsym_resolve; the entry calls through the patched IAT and returns the
# registered host function's result. Also proves re-binding (runtime extension)
# is picked up by a re-snap. Kernel-clean: wubu_pe.c + wubu_modsym.c only.
test_pe_modsym: $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_pe.h $(KERNEL)/wubu_modsym.c $(KERNEL)/wubu_modsym.h $(KERNEL)/test/wubu_pe_modsym_test.c
	$(CC) -O1 -std=c11 -Wall -Wextra -Wno-array-bounds -I$(KERNEL) $(KERNEL)/test/wubu_pe_modsym_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_modsym.c -o $(KERNEL)/wubu_pe_modsym_test
	$(KERNEL)/./wubu_pe_modsym_test

# test_holyd_roundtrip -- P2 CLOSING forcing function (cross-repo). holyd
# compiles an expression -> hd_write_pe (wubunos emitter) writes a REAL PE32+
# EXE -> the in-kernel wubu_pe loader parses/maps/relocates the EMITTED bytes
# -> wubu_pe_call_entry runs the emitted entry -> holyd result (42) out of the
# loader, at both the preferred base and a shifted base. Proves an on-disk
# holyd executable self-hosts on WuBuOS's own loader. Links the wubunos
# emitter (holyd_pe.c, NOT part of the normal front-end set) alongside the
# loader + registry.
test_holyd_roundtrip: $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_pe.h $(KERNEL)/wubu_modsym.c $(KERNEL)/test/wubu_pe_roundtrip_test.c $(COMP)/holyd_codegen.h /home/wubu/wubunos/holyd_pe.c
	$(CC) -O0 -g -DWUBU_HOSTED -I$(COMP) -I$(JIT) -I$(KERNEL) $(JIT_SRCS) $(RT)/wubu_spawn.c $(COMP)/holyd_lexer.c $(COMP)/holyd_parse.c $(COMP)/holyd_parse_ast.c $(COMP)/holyd_codegen.c $(COMP)/holyd_codegen_emit.c $(COMP)/holyd_codegen_expr.c $(COMP)/holyd_codegen_stmt.c $(COMP)/holyd_codegen_api.c $(COMP)/wubu_preproc.c $(COMP)/holyd_runtime.c /home/wubu/wubunos/holyd_pe.c $(KERNEL)/test/wubu_pe_roundtrip_test.c $(KERNEL)/wubu_pe.c $(KERNEL)/wubu_modsym.c $(KERNEL)/libc_string.c -o $(KERNEL)/wubu_pe_roundtrip_test -ldl
	$(KERNEL)/./wubu_pe_roundtrip_test

# test_wubu_bus -- P3 spine: the message bus implementing the D-Bus
# well-known-name ownership + on-demand activation contract (Mint baseline
# §4.1). An unowned name call fires the activator (the bus starts the service
# on first use); once the service claims the name, requests deliver. This is
# the first concrete primitive for the /n/background session+bus runtime.
test_wubu_bus: $(RT)/wubu_bus.c $(RT)/wubu_bus.h $(RT)/wubu_bus_test.c
	$(CC) -O0 -g -std=c11 -Wall -I$(RT) $(RT)/wubu_bus_test.c $(RT)/wubu_bus.c -o $(RT)/wubu_bus_test
	$(RT)/./wubu_bus_test

# test_xdg_autostart -- P3: the XDG Autostart .desktop contract (Mint baseline
# §3.2). Scans a temp dir of real .desktop files and asserts the freedesktop
# gating: launchable entries have their Exec parsed (field codes stripped,
# quoted args kept as one token), Hidden=true / X-GNOME-Autostart-enabled=false
# / non-Application entries are skipped.
test_xdg_autostart: $(RT)/wubu_xdg_autostart.c $(RT)/wubu_xdg_autostart.h $(RT)/wubu_xdg_autostart_test.c
	$(CC) -O0 -g -std=c11 -Wall -I$(RT) $(RT)/wubu_xdg_autostart_test.c $(RT)/wubu_xdg_autostart.c -o $(RT)/wubu_xdg_autostart_test
	$(RT)/./wubu_xdg_autostart_test

# test_session_boot -- P3: the session-boot orchestrator (the cinnamon-session
# analogue). Scans autostart dirs, and via an INJECTABLE launcher proves it
# starts every launchable .desktop app AND claims each app's well-known name on
# the session bus (so a running background app is addressable after boot).
# Links wubu_session_boot + wubu_xdg_autostart + wubu_bus.
test_session_boot: $(RT)/wubu_session_boot.c $(RT)/wubu_session_boot.h $(RT)/wubu_xdg_autostart.c $(RT)/wubu_bus.c $(RT)/wubu_session_boot_test.c
	$(CC) -O0 -g -std=c11 -Wall -I$(RT) $(RT)/wubu_session_boot_test.c $(RT)/wubu_session_boot.c $(RT)/wubu_xdg_autostart.c $(RT)/wubu_bus.c -o $(RT)/wubu_session_boot_test
	$(RT)/./wubu_session_boot_test

# GAP F: hosted END-TO-END first-boot onboarding stream. wubu_onboarding
# decides first-boot(GREETER) vs configured(DESKTOP) from a persisted sentinel;
# the test drives boot#1 greeter -> complete -> boot#2 desktop through the real
# session-boot launcher, and asserts the config signature round-trips.
test_wubu_onboarding: $(RT)/wubu_onboarding.c $(RT)/wubu_onboarding.h $(RT)/wubu_session_boot.c $(RT)/wubu_session_boot.h $(RT)/wubu_xdg_autostart.c $(RT)/wubu_bus.c $(RT)/test/wubu_onboarding_test.c
	$(CC) -O0 -g -std=c11 -Wall -I$(RT) $(RT)/test/wubu_onboarding_test.c $(RT)/wubu_onboarding.c $(RT)/wubu_session_boot.c $(RT)/wubu_xdg_autostart.c $(RT)/wubu_bus.c -o $(RT)/wubu_onboarding_test
	$(RT)/./wubu_onboarding_test

# test_ns_background -- P3: the /n/background control subtree. Publishes the
# session-boot's live state (session, bus names, bus conn count, autostart
# list) as /n/background files via the shared ns_mkdir/ns_write FS core. The
# test points g_ns_root at a temp dir directly (memory-constrained rule: link
# wubu_ns_fs.o + sources, NOT the heavy wubu_ns_bridge.o).
test_ns_background: $(RT)/wubu_ns_background.c $(RT)/wubu_ns_background.h $(RT)/wubu_session_boot.c $(RT)/wubu_bus.c $(RT)/wubu_xdg_autostart.c $(RT)/wubu_logind.c $(RT)/wubu_auth.c $(RT)/wubu_ns_background_test.c
	$(CC) -O0 -g -std=c11 -Wall -D_GNU_SOURCE -I$(RT) -c $(RT)/wubu_ns_background_test.c -o /tmp/wubu_ns_background_test.o
	$(CC) -O0 -g -no-pie -I$(RT) \
