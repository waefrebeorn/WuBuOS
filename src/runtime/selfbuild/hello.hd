/* wubu_selfbuild.hd -- a holyd-language program: THE stage-0 self-build seed.
 *
 * The compiler reads THIS file as its own language, emits a PE, drops it into
 * /n, and the module registry loads+runs it. This version exercises DATA: a
 * global char array with a brace initializer ("HELLO") becomes a .data section
 * the emitter emits and the loader must relocate + index into. f() reads buf[0]
 * back -> entry returns 'H' = 72.
 */
char buf[9] = { 72, 69, 76, 76, 79, 0, 0, 0, 0 };
int f() { return (int)buf[0]; }
