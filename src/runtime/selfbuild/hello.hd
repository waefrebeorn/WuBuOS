/* wubu_selfbuild.hd -- a holyd-language program: THE stage-0 self-build seed.
 *
 * The compiler reads THIS file as its own language, emits a PE, drops it into
 * /n, and the module registry loads+runs it. This version has TWO functions
 * and a CROSS-FUNCTION CALL: f() returns sum(), and sum() computes the loop
 * sum(1..10)=55. Entry f()->sum() must come back 55.
 */
int g = 0;
int sum() { int s = 0; for (int i = 1; i <= 10; i++) s += i; return s; }
int f() { return sum(); }
