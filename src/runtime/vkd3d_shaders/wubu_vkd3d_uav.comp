#version 450
/* A compute shader writing through a STORAGE BUFFER -- the D3D12 UAV path.
 * Every invocation writes its own global id doubled. */
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) buffer Data { uint values[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    values[i] = i * 2u;
}
